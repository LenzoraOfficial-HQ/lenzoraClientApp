# .env.example - safe to commit.
# Copy this file to ".env" and fill in the password. ".env" is never committed.

# Shared development database (Aiven MySQL) - the database the team works on.
DB_URL=jdbc:mysql://lenzora-db-service-lenzora-db-host.k.aivencloud.com:26497/defaultdb?ssl-mode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=

# The shared database already has the schema, so Hibernate must never change it.
DDL_AUTO=none

# Initial administrator account. Set a private password in ".env"; do not
# commit real credentials. The account is created only if app_user is empty.
ADMIN_EMAIL=admin@lenzora.lk
ADMIN_PASSWORD=

# Google sign-in (optional). Fill in both values from the Google Cloud console
# and "Continue with Google" appears on the login page. The client needs this
# redirect URI registered: http://localhost:8081/login/oauth2/code/google
# A first-time Google user gets an account created automatically, and the role
# on that row decides the landing page: an ADMIN goes to the admin portal,
# everyone else to the client dashboard. Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password hash for accounts created by Google sign-in. Leave blank to generate
# a fresh random, unusable one at every start.
GOOGLE_ACCOUNT_PASSWORD=
# Prefer your own machine? Point at a local MySQL instead and let the
# application create the schema:
# DB_URL=jdbc:mysql://localhost:3306/Lenzora?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_local_password
# DDL_AUTO=update
