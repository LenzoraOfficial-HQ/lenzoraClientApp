# .env.example - safe to commit.
# Copy this file to ".env" and fill in the password. ".env" is never committed.

# Shared development database (Aiven MySQL) - the database the team works on.
DB_URL=jdbc:mysql://lenzora-db-service-lenzora-db-host.k.aivencloud.com:26497/defaultdb?ssl-mode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=

# The shared database already has the schema, so Hibernate must never change it.
DDL_AUTO=none

# Administrator account the application keeps ready on every start, so the
# admin portal is always reachable. ADMIN_EMAIL is only an identifier; the
# password is the secret - put your own value in ".env" and leave it empty here.
ADMIN_EMAIL=admin@lenzora.lk
ADMIN_PASSWORD=

# Prefer your own machine? Point at a local MySQL instead and let the
# application create the schema:
# DB_URL=jdbc:mysql://localhost:3306/Lenzora?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_local_password
# DDL_AUTO=update
